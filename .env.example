DATABASE_URL="postgresql://game_user:game_password@localhost:5433/threejs_game?schema=public"
ANALYTICS_DATABASE_URL="postgresql://game_user:game_password@localhost:5433/threejs_game?schema=analytics&options=-csearch_path%3Danalytics"
REDIS_URL="redis://localhost:6379"
PORT=8080
LOG_STATS=false
AUTH_SESSION_DAYS=7

# S3-compatible asset storage.
# MinIO local:
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
S3_BUCKET="threejs-game-assets"
S3_FORCE_PATH_STYLE=true
S3_STORAGE_PROVIDER="minio"

# Cloudflare R2 example:
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="<r2-access-key>"
# S3_SECRET_ACCESS_KEY="<r2-secret-key>"
# S3_BUCKET="<bucket>"
# S3_FORCE_PATH_STYLE=true
# S3_STORAGE_PROVIDER="cloudflare-r2"

# AWS S3 example:
# S3_ENDPOINT=""
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="<aws-access-key>"
# S3_SECRET_ACCESS_KEY="<aws-secret-key>"
# S3_BUCKET="<bucket>"
# S3_FORCE_PATH_STYLE=false
# S3_STORAGE_PROVIDER="aws-s3"

# Supabase Storage S3 example:
# S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="<supabase-s3-access-key>"
# S3_SECRET_ACCESS_KEY="<supabase-s3-secret-key>"
# S3_BUCKET="<bucket>"
# S3_FORCE_PATH_STYLE=true
# S3_STORAGE_PROVIDER="supabase-storage"

# Backblaze B2 S3 example:
# S3_ENDPOINT="https://s3.<region>.backblazeb2.com"
# S3_REGION="<region>"
# S3_ACCESS_KEY_ID="<b2-key-id>"
# S3_SECRET_ACCESS_KEY="<b2-application-key>"
# S3_BUCKET="<bucket>"
# S3_FORCE_PATH_STYLE=true
# S3_STORAGE_PROVIDER="backblaze-b2"

# Keep empty to serve files through /api/assets/:id/file.
# Set to a public bucket/CDN base URL when your bucket is public.
ASSET_PUBLIC_BASE_URL=""
ASSET_MAX_UPLOAD_BYTES=52428800
