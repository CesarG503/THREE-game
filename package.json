{
  "type": "module",
  "name": "threejs-game",
  "version": "1.0.0",
  "description": "Three.js Game",
  "scripts": {
    "dev": "vite",
    "server": "tsc && node ./dist/index.js",
    "server:watch": "tsc --watch",
    "start": "concurrently \"npm run dev -- --host\" \"npm run server\"",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:analytics:generate": "PRISMA_SCHEMA_PATH=prisma/analytics.prisma PRISMA_DATABASE_URL=\"postgresql://game_user:game_password@localhost:5433/threejs_game?schema=analytics\" prisma generate --schema=prisma/analytics.prisma",
    "db:analytics:setup": "npx tsx scripts/setup-analytics-db.ts",
    "db:analytics:migrate": "npx tsx scripts/migrate-analytics.ts",
    "db:analytics:test-migration": "npx tsx scripts/test-analytics-migrations.ts",
    "db:analytics:verify": "npx tsx scripts/verify-analytics-setup.ts",
    "db:analytics:test-broker": "npx tsx scripts/test-event-broker.ts",
    "db:analytics:generate-types": "npx tsx scripts/generate-event-types.ts",
    "db:analytics:test-schema": "npx tsx scripts/test-schema-registry.ts",
    "db:analytics:test-feature": "npx tsx scripts/test-feature-store.ts",
    "db:analytics:test-ingestion": "npx tsx scripts/test-navigation-ingestion.ts",
    "db:analytics:test-session": "npx tsx scripts/test-session-telemetry.ts",
    "db:analytics:test-interaction": "npx tsx scripts/test-game-interaction.ts",
    "db:analytics:test-ui": "npx tsx scripts/test-ui-telemetry.ts",
    "db:analytics:test-virality": "npx tsx scripts/test-map-virality.ts",
    "db:analytics:test-quality": "npx tsx scripts/test-data-quality.ts",
    "db:analytics:test-monitoring": "npx tsx scripts/test-telemetry-monitoring.ts",
    "db:analytics:test-alerts": "npx tsx scripts/test-telemetry-alerts.ts",
    "db:analytics:gdpr-delete": "npx tsx scripts/gdpr-delete-user.ts",
    "db:analytics:test-privacy": "npx tsx scripts/test-data-privacy.ts",
    "db:analytics:test-bots": "npx tsx scripts/test-bot-filter.ts",
    "db:analytics:test-cohorts": "npx tsx scripts/test-cohort-retention.ts",
    "db:analytics:test-funnel": "npx tsx scripts/test-conversion-funnel.ts"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.182.0",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.1",
    "postcss": "8.5.6",
    "prisma": "^7.8.0",
    "tailwindcss": "4.1.17",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "8.0.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "@dimforge/rapier3d-compat": "0.19.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@redis/client": "^6.0.0",
    "animejs": "4.3.6",
    "busboy": "^1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^17.4.2",
    "iconify-icon": "^3.0.2",
    "lucide-react": "0.554.0",
    "next": "16.2.4",
    "pg": "^8.21.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "three": "0.182.0",
    "three.quarks": "0.17.0",
    "ws": "8.18.3"
  }
}
