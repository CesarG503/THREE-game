generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../src/generated/analytics-client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["analytics"]
}

model User {
  id             String          @id
  email          String
  username       String
  displayName    String?
  createdAt      DateTime
  updatedAt      DateTime
  events           RawEvent[]
  playerFeatures   PlayerFeatures?
  socialAffinity1  SocialAffinity[] @relation("AffinityUser1")
  socialAffinity2  SocialAffinity[] @relation("AffinityUser2")
  fatiguedMaps     FatiguedMap[]

  @@schema("analytics")
}

model GameMap {
  id          String       @id
  slug        String
  name        String
  ownerId     String?
  isPublished Boolean
  createdAt   DateTime
  updatedAt   DateTime
  mapFeatures     MapFeatures?
  fatiguedPlayers FatiguedMap[]

  @@schema("analytics")
}

model RawEvent {
  id        String   @default(cuid())
  eventType String
  userId    String?
  timestamp DateTime @default(now())
  payload   Json
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([id, timestamp])
  @@schema("analytics")
}

model PlayerFeatures {
  userId                String   @id
  lastActive            DateTime
  totalPlayTime         Float    @default(0) // in seconds
  matchesPlayed         Int      @default(0)
  preferredLanguage     String   @default("en")
  explorerRatio         Float?
  playerProfile         String?
  popularitySensitivity Float?
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("analytics")
}

model MapFeatures {
  mapId           String   @id
  totalJoins      Int      @default(0)
  totalLeaves     Int      @default(0)
  bounceCount     Int      @default(0)
  averageDuration Float    @default(0) // in seconds
  bounceRate      Float    @default(0) // fraction 0 to 1
  map             GameMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@schema("analytics")
}

model SocialAffinity {
  id        String   @id @default(cuid())
  userId1   String
  userId2   String
  affinity  Float    @default(0)
  updatedAt DateTime @updatedAt

  user1     User     @relation("AffinityUser1", fields: [userId1], references: [id], onDelete: Cascade)
  user2     User     @relation("AffinityUser2", fields: [userId2], references: [id], onDelete: Cascade)

  @@unique([userId1, userId2])
  @@index([userId1, affinity(sort: Desc)])
  @@index([userId2, affinity(sort: Desc)])
  @@schema("analytics")
}

model FatiguedMap {
  userId     String
  mapId      String
  fatiguedAt DateTime @default(now())
  expiresAt  DateTime

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  map        GameMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([userId, mapId])
  @@index([expiresAt])
  @@schema("analytics")
}
