{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "enum": ["PageView", "SessionStart", "MatchJoin", "MatchLeave", "SessionHeartbeat", "SessionEnd", "MatchStart", "MatchEnd", "UiImpression", "UiClick", "UiScrollDepth", "EditorSession", "EditorAction", "MapStateTransition", "QueueEnter", "QueueLeave", "MatchFormed", "FriendRequestSent", "FriendRequestAccepted", "GameInviteSent", "GameInviteAccepted"]
    },
    "userId": {
      "type": ["string", "null"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": ["id", "eventType", "timestamp", "payload"],
  "additionalProperties": false
}
