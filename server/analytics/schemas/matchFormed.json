{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "matchId": {
      "type": "string"
    },
    "queueIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "latencyDisparity": {
      "type": "number"
    },
    "playerPings": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  },
  "required": ["matchId", "queueIds", "latencyDisparity"],
  "additionalProperties": false
}
