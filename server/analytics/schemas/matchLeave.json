{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "roomId": {
      "type": "string",
      "format": "uuid"
    },
    "mapId": {
      "type": "string",
      "format": "uuid"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0
    },
    "reason": {
      "type": "string"
    }
  },
  "required": ["roomId", "mapId", "durationSeconds"],
  "additionalProperties": false
}
