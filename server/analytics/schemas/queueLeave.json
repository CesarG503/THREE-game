{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "queueId": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": ["match_found", "cancel_by_user"]
    },
    "durationSeconds": {
      "type": "number"
    }
  },
  "required": ["queueId", "reason", "durationSeconds"],
  "additionalProperties": false
}
